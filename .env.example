# Copy to .env and fill in. Never commit .env.

# First administrator - created only when the database has no users yet. Change the password after first sign-in.
CLUB_ADMIN_LOGIN=admin@example.org
CLUB_ADMIN_PASSWORD=
CLUB_ADMIN_NAME=Secretary

# Public address of the app, used in the links inside messages (no trailing slash)
CLUB_PUBLIC_URL=https://club.example.org

# Where the SQLite database and uploads live (default: ./data)
# CLUB_DATA=/data

# ---- WhatsApp (Meta WhatsApp Cloud API) ----
# Create a Meta app, add WhatsApp, note the phone number ID and a permanent system-user token.
# CLUB_WA_TOKEN=
# CLUB_WA_PHONE_ID=
# An approved message template with a single {{1}} body parameter lets you message members outside the 24-hour window:
# CLUB_WA_TEMPLATE=club_update
# CLUB_WA_TEMPLATE_LANG=en

# ---- SMS (any HTTP gateway; Indian DLT-registered template recommended) ----
# GET style, e.g. Fast2SMS / Textlocal:  placeholders {to} {text} {sender} {dlt} {key}
# CLUB_SMS_URL=https://www.fast2sms.com/dev/bulkV2?authorization={key}&route=dlt&sender_id={sender}&message={dlt}&variables_values={text}&numbers={to}
# POST style, e.g. MSG91:
# CLUB_SMS_URL=https://control.msg91.com/api/v5/flow/
# CLUB_SMS_BODY={"template_id":"{dlt}","sender":"{sender}","mobiles":"{to}","message":"{text}"}
# CLUB_SMS_HEADERS={"authkey":"YOUR_AUTH_KEY"}
# CLUB_SMS_KEY=
# CLUB_SMS_SENDER=
# CLUB_SMS_DLT_TEMPLATE=

# ---- E-mail (SMTP) ----
# CLUB_SMTP_HOST=smtp.gmail.com
# CLUB_SMTP_PORT=587
# CLUB_SMTP_USER=
# CLUB_SMTP_PASS=
# CLUB_SMTP_FROM=club@example.org

# Hour of the day (server time) after which the daily jobs run: birthday wishes, event reminders, book reminders
# CLUB_DAILY_HOUR=8
